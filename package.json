{
  "name": "scam-saver",
  "version": "1.0.0",
  "private": true,
  "description": "Scam Saver fraud detection and reporting platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "seed": "node backend/seed.js",
    "test": "node --test backend/tests/*.test.js",
    "migrate:check": "node backend/migrate-database.js",
    "migrate:local": "node backend/migrate-database.js --apply",
    "evidence:migrate:check": "node backend/migrate-evidence-to-cloud.js",
    "evidence:migrate": "node backend/migrate-evidence-to-cloud.js --apply"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
